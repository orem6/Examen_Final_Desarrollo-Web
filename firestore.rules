rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validReport(d, id) {
      return d.keys().hasAll(['id','code','title','description','category','location','name','email','ownerUid','status','createdAt','updatedAt','hasPhoto'])
        && d.keys().hasOnly(['id','code','title','description','category','location','name','email','ownerUid','status','createdAt','updatedAt','hasPhoto'])
        && id.matches('^[0-9a-fA-F-]{36}$') && d.id == id && text(d.code,12,12)
        && text(d.title,5,120) && text(d.description,20,3000) && text(d.location,5,250)
        && text(d.name,0,100) && text(d.email,0,150)
        && d.category in ['Vías y calles','Alumbrado público','Agua y drenajes','Limpieza y residuos','Espacios públicos','Otros']
        && d.ownerUid == request.auth.uid && d.status == 'Recibido' && d.hasPhoto == true
        && text(d.createdAt,24,24) && d.createdAt == d.updatedAt
        && getAfter(/databases/$(database)/documents/photos/$(id)).data.ownerUid == request.auth.uid;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /reports/{id} {
      allow create: if signedIn() && validReport(request.resource.data,id);
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['Recibido','En revisión','En proceso','Resuelto']
        && text(request.resource.data.updatedAt,24,24);
      allow delete: if false;
    }
    match /photos/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['ownerUid','data'])
        && request.resource.data.keys().hasOnly(['ownerUid','data'])
        && request.resource.data.ownerUid == request.auth.uid
        && text(request.resource.data.data,30,460000)
        && request.resource.data.data.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/=]+$')
        && getAfter(/databases/$(database)/documents/reports/$(id)).data.ownerUid == request.auth.uid;
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list, update, delete: if false;
    }
  }
}
